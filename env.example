# Bu dosyayı kopyalayıp .env yap:  cp env.example .env
# Değerleri doldur; .env asla git'e eklenmez (.gitignore).

OPENROUTER_API_KEY=
OPENROUTER_MODEL=anthropic/claude-sonnet-4

# ./ardi status ile gördüğün agent adresi (commit staker):
ARDI_STAKER=0x

# İsteğe bağlı:
# OPENROUTER_POLL_SEC=25
# OPENROUTER_VRF_RETRY_SEC=20
# OPENROUTER_VRF_INSCRIBE_MAX_TRIES=60
